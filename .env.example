# Copia este archivo como .env.local y rellena los valores.

# Obligatorio. Clave con la que se sella la cookie de sesión (AES-256-GCM).
# Mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
# En producción va en Secret Manager, nunca en claro.
SESSION_SECRET=

# Opcional (4 por defecto). Pestañas en paralelo durante la extracción.
# Más pestañas = más rápido, pero más memoria.
# EXTRACTOR_CONCURRENCIA=4
